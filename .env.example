# ============================================================
# PDF 智能学习助手 - 环境变量配置
# 复制本文件为 .env 并填入你的密钥
# ============================================================

# 模型名称（DeepSeek 支持 deepseek-v4-flash / deepseek-v4-pro）
LLM_MODEL_ID=deepseek-v4-flash

# API 密钥（填入你的 DeepSeek API Key，获取：https://platform.deepseek.com/）
LLM_API_KEY=sk-your-deepseek-api-key

# 服务地址（DeepSeek 官方）
LLM_BASE_URL=https://api.deepseek.com

# 超时时间（秒）
LLM_TIMEOUT=60

# 嵌入模型类型：local(本地 sentence-transformers，免费但 CPU 慢) | dashscope(云端快，需 EMBED_API_KEY)
EMBED_MODEL_TYPE=local
# 若用 dashscope 云端嵌入，填阿里云百炼 key：
# EMBED_API_KEY=sk-your-dashscope-key

# 向量存储模式：memory(进程内，重启丢失) | qdrant(持久化，需 QDRANT_URL)
QDRANT_MODE=memory
